# =====================================================================
# BOF Edge backend â€” copy to `.env` and fill in real values.
# NEVER commit a real .env or any secret to version control.
# =====================================================================

APP_NAME="BOF Edge API"
ENVIRONMENT=local              # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

# --- Database ---------------------------------------------------------
# Local dev via docker-compose (postgres service).
DATABASE_URL=postgresql+asyncpg://bof:bof_dev_password@localhost:5432/bof_scanner
# On Render the connection string is injected; asyncpg driver is required:
# DATABASE_URL=postgresql+asyncpg://bof:password@host.render.internal:5432/bof_scanner

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Auth / JWT -------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_MINUTES=30

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Rate limiting (in-memory; Redis can replace this later) ----------
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Firebase Cloud Messaging (used from Phase 6) ---------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Market data provider (used from Phase 8) --------------------------
MARKET_DATA_PROVIDER=demo
MARKET_DATA_API_KEY=
MARKET_BASE_URL=https://api.example-ohlcv.com/v1
MARKET_MAX_RETRIES=3

# --- Redis (optional; rate limiting) — leave empty locally, set on Render ---
REDIS_URL=

# --- Live demo loop (Phase 4/6) ---
LIVE_DEMO_ENABLED=true
DEMO_TICK_SECONDS=10

# --- Seeding (optional local convenience) ------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=


